# Copy this file to ".env" for running the API on your computer.
# (.env is ignored by git. Render uses its own Environment settings instead.)

# Any long random text. Logins made with one secret don't work with another.
JWT_SECRET=change-me-to-a-long-random-string

# Your local PostgreSQL (the database "hps_development" is created for you)
DB_USERNAME=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Optional: to work on the live Supabase data instead of a local copy, use the
# Supabase "Session pooler" or direct connection string (port 5432), e.g.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
# Careful: changes then go straight to the live website.
